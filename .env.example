# ========================================================
# TravelGo Cloud Platform - Environment Configuration Example
# Copy this file to '.env' for local development.
# IMPORTANT: Never commit '.env' containing real secrets to Git.
# ========================================================

# Flask Settings
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-with-a-secure-random-32-char-string-in-production
PORT=5000

# AWS Development Toggle
# When USE_MOCK_AWS=true, the app uses in-memory / local JSON data stores
# so you can develop & test locally without needing AWS account credentials.
USE_MOCK_AWS=true

# AWS Configuration (Used when USE_MOCK_AWS=false or in Production on EC2)
AWS_REGION=us-east-1
# When running on EC2 with an attached IAM Role, leave ACCESS_KEY & SECRET_KEY empty!
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS DynamoDB Tables
DYNAMODB_USERS_TABLE=travelgo_users
DYNAMODB_BOOKINGS_TABLE=travelgo_bookings

# AWS SNS Topic for Booking & Cancellation Notifications
SNS_BOOKING_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:travelgo-booking-alerts

# AWS CloudWatch Settings
CLOUDWATCH_LOG_GROUP=/travelgo/application
